// PACT, Proof of Acceptance Criteria Testing.
//
// Nobody says what to verify: the listener starts this job when a delivery
// appears on the chain, and the deliveries themselves are read from the
// contract the developer declared them to.

pipeline {
    agent any                                   // creates the workspace

    options {
        // one build at a time: two builds signing together would use the same
        // nonce on the verifier's account, and one of the two transactions
        // would be thrown away
        disableConcurrentBuilds()
    }

    parameters {
        // filled by the listener, which found the contract on the chain, not
        // by a person. A wrong value is harmless: the job refuses to work for
        // a contract that has not named this verifier
        string(
            name: 'CONTRACT',
            defaultValue: '',
            description: 'User stories contract that declared the delivery'
        )
    }

    environment {
        CONTRACT_ADDRESS = "${params.CONTRACT}"

        WRITE_BACK = 'true'                     // false here = dry run, writes nothing and spends no gas
        SIGN_CHAIN = 'true'

        VERIFY_IMAGE = 'criteria-sandbox:1'     // the delivered code runs in here, never on this machine

        OP_URL       = 'http://127.0.0.1:8090'  // my local OpenProject
        TAIGA_URL    = 'https://api.taiga.io'
        TAIGA_SLUG   = 'simomnz-prova-api'
        JIRA_URL     = 'https://simomnz.atlassian.net'
        JIRA_PROJECT = 'KAN'                    // so the "KAN-" does not have to be written every time
        SEPOLIA_RPC  = 'https://ethereum-sepolia-rpc.publicnode.com'   // enough here: this job reads the contract, it does not search the logs

        VENV = '/var/lib/jenkins/venv-verifica'           // outside the workspace
        VERIFY_STATE = '/var/lib/jenkins/attempted.json'  // outside too, the workspace is wiped between builds
    }

    stages {

        stage('1. Verifier') {
            steps {
                echo '--- the verification system itself ---'
                git branch: 'main', url: 'https://github.com/simomnz/Tirocinio.git'
            }
        }

        stage('2. Dependencies') {
            steps {
                echo '--- behave and web3, in the versions they were written against ---'
                sh '''
                    if [ ! -d "$VENV" ]; then       # -d for a folder, ! if it does not exist
                        python3 -m venv "$VENV"     # created once only
                    fi
                    . "$VENV/bin/activate"          # . is source

                    pip install --quiet -r vocabolario/requirements.txt   # -r list from a file, --quiet errors only
                    echo "Ready:"
                    pip list --format=freeze | grep -E '^(behave|web3)='  # -E extended regex, ^ start of line
                '''
            }                                   // SINGLE quotes: no substitution, the shell resolves $VENV
        }

        stage('3. Sandbox') {
            steps {
                echo '--- the image the delivered code runs in ---'
                sh '''
                    docker build --quiet -t "$VERIFY_IMAGE" sandbox/   # seconds when already built, the layers are cached
                '''
            }
        }

        stage('4. Deliveries') {
            steps {
                withCredentials([               // credentials NOT VISIBLE
                    string(credentialsId: 'op-token',     variable: 'OP_TOKEN'),
                    string(credentialsId: 'taiga-user',   variable: 'TAIGA_USER'),
                    string(credentialsId: 'taiga-pass',   variable: 'TAIGA_PASS'),
                    string(credentialsId: 'jira-user',    variable: 'JIRA_USER'),
                    string(credentialsId: 'jira-token',   variable: 'JIRA_TOKEN'),
                    string(credentialsId: 'verifier-key', variable: 'VERIFIER_KEY')
                ]) {                            // masked as ****** in the log
                    sh '''
                        set +x                  # set +x does not print the commands
                        . "$VENV/bin/activate"
                        cd vocabolario

                        if [ -z "$CONTRACT_ADDRESS" ]; then   # started by hand, with nobody saying which contract
                            echo "No contract given: this job is started by the listener"
                            exit 0
                        fi

                        flags=""
                        if [ "$WRITE_BACK" = "true" ]; then flags="$flags --write"; fi
                        if [ "$SIGN_CHAIN" = "true" ]; then flags="$flags --chain"; fi

                        waiting=$(python3 pending.py)       # the chain says what to verify
                        if [ -z "$waiting" ]; then          # -z the string IS empty
                            echo "No delivery waiting"
                            exit 0
                        fi

                        problems=0
                        for id in $waiting; do
                            echo "--- user story $id"

                            status=0
                            python3 verify.py --story "$id" $flags || status=$?   # || keeps set -e from aborting the loop

                            if [ "$status" = "2" ]; then    # it could not even try, so it must be tried again
                                echo "user story $id could not be verified, it stays in the queue"
                                problems=1
                            else                            # 0 passed and is recorded on chain, 1 did not pass
                                python3 pending.py --mark "$id"   # noted, so the same delivery is not commented again every round
                            fi
                        done

                        if [ "$problems" != "0" ]; then
                            echo "Some deliveries could not be verified"
                            exit 1                          # a broken system is a red build, a rejected delivery is not
                        fi
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Round complete: every delivery found has been verified.'
        }
        failure {
            echo 'The verification system could not work: the reason is in the log.'
        }
    }

}
